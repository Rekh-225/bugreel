{
  "name": "bugreel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/extension",
    "test": "playwright test",
    "ext:build": "node apps/extension/scripts/build.mjs",
    "ext:package": "node apps/extension/scripts/build.mjs --zip",
    "test:extension": "node apps/extension/scripts/build.mjs && playwright test -c playwright.extension.config.ts",
    "ext:examples": "node apps/extension/scripts/build.mjs && node apps/extension/scripts/examples.mjs",
    "demo:record": "playwright test --config scripts/demo/playwright.config.ts",
    "demo:encode": "node scripts/demo/encode.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "next": "16.3.5",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
